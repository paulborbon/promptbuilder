# Server only. Never upload .env or data/ to a static website or commit them.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Exact frontend origin, without a path/trailing slash. Comma-separated if needed.
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=YOUR-SENDING-MAILBOX@gmail.com
SMTP_PASS=YOUR-GOOGLE-APP-PASSWORD
MAIL_FROM=YOUR-SENDING-MAILBOX@gmail.com
PAUL_EMAIL=YOUR-GMAIL@gmail.com
# Only server-approved reference IDs can receive inquiries. Add more entries here.
REFERRERS_JSON='{"maven-website-builder":{"name":"Maven Website Builder","email":"borbon_pj@hotmail.com"}}'
TURNSTILE_SITE_KEY=YOUR-PUBLIC-TURNSTILE-SITE-KEY
TURNSTILE_SECRET_KEY=YOUR-PRIVATE-TURNSTILE-SECRET
# Persistent private disk path; run exactly one backend instance.
DB_PATH=./data/referrals.sqlite
# Set to 1 only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
